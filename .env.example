# Copy to .env (which is gitignored) and change the password.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks

# Used when you run the app outside Docker (uvicorn main:app) against the
# Postgres container. Leave it empty to fall back to the SQLite file.
DATABASE_URL=postgresql://tasks:change-me@localhost:5432/tasks

# --- LLM provider (any OpenAI-compatible API) ---
# Local, free, no key:  LLM_BASE_URL=http://localhost:11434/v1/  LLM_API_KEY=ollama  LLM_MODEL=qwen3.5
# Hosted, free:         LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...  LLM_MODEL=openrouter/free
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5
LLM_TIMEOUT_SECONDS=30
# "none" switches off hidden reasoning on thinking models (qwen3.x on Ollama): ~40s -> <1s per call. Leave empty for others.
LLM_REASONING_EFFORT=none
# LLM_STUB=1 returns a fixed valid answer with no model call; LLM_ENABLED=false is the kill switch (503).
LLM_STUB=0
LLM_ENABLED=true
